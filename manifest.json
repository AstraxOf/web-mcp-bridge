{
  "manifest_version": 3,
  "name": "Web MCP Bridge",
  "version": "1.8.0",
  "description": "Connect ChatGPT, Gemini, Claude, DeepSeek, Grok, Z.ai, Qwen and Kimi to your local MCP servers over WebSocket.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Web MCP Bridge",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "permissions": ["storage", "alarms", "notifications", "scripting"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://gemini.google.com/*",
    "https://claude.ai/*",
    "https://chat.deepseek.com/*",
    "https://grok.com/*",
    "https://*.grok.com/*",
    "https://grok.x.ai/*",
    "https://chat.z.ai/*",
    "https://z.ai/*",
    "https://chat.qwen.ai/*",
    "https://www.kimi.ai/*",
    "https://kimi.ai/*",
    "https://www.kimi.com/*",
    "https://kimi.com/*",
    "ws://localhost/*",
    "ws://127.0.0.1/*",
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://raw.githubusercontent.com/AstraxOf/web-mcp-bridge/*"
  ],
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": [
        "shared/i18n.js",
        "content_scripts/utils.js",
        "content_scripts/mcp_parser.js",
        "content_scripts/prompt_builder.js",
        "content_scripts/tool_catalog.js",
        "content_scripts/ui_widget.js",
        "content_scripts/adapters/base_adapter.js",
        "content_scripts/adapters/chatgpt.js",
        "content_scripts/core_bridge.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://gemini.google.com/*"],
      "js": [
        "shared/i18n.js",
        "content_scripts/utils.js",
        "content_scripts/mcp_parser.js",
        "content_scripts/prompt_builder.js",
        "content_scripts/tool_catalog.js",
        "content_scripts/ui_widget.js",
        "content_scripts/adapters/base_adapter.js",
        "content_scripts/adapters/gemini.js",
        "content_scripts/core_bridge.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://claude.ai/*"],
      "js": [
        "shared/i18n.js",
        "content_scripts/utils.js",
        "content_scripts/mcp_parser.js",
        "content_scripts/prompt_builder.js",
        "content_scripts/tool_catalog.js",
        "content_scripts/ui_widget.js",
        "content_scripts/adapters/base_adapter.js",
        "content_scripts/adapters/claude.js",
        "content_scripts/core_bridge.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://chat.deepseek.com/*"],
      "js": [
        "shared/i18n.js",
        "content_scripts/utils.js",
        "content_scripts/mcp_parser.js",
        "content_scripts/prompt_builder.js",
        "content_scripts/tool_catalog.js",
        "content_scripts/ui_widget.js",
        "content_scripts/adapters/base_adapter.js",
        "content_scripts/adapters/deepseek.js",
        "content_scripts/core_bridge.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://grok.com/*",
        "https://*.grok.com/*",
        "https://grok.x.ai/*"
      ],
      "js": [
        "shared/i18n.js",
        "content_scripts/utils.js",
        "content_scripts/mcp_parser.js",
        "content_scripts/prompt_builder.js",
        "content_scripts/tool_catalog.js",
        "content_scripts/ui_widget.js",
        "content_scripts/adapters/base_adapter.js",
        "content_scripts/adapters/grok.js",
        "content_scripts/core_bridge.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://chat.z.ai/*",
        "https://z.ai/*"
      ],
      "js": [
        "shared/i18n.js",
        "content_scripts/utils.js",
        "content_scripts/mcp_parser.js",
        "content_scripts/prompt_builder.js",
        "content_scripts/tool_catalog.js",
        "content_scripts/ui_widget.js",
        "content_scripts/adapters/base_adapter.js",
        "content_scripts/adapters/zai.js",
        "content_scripts/core_bridge.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://chat.qwen.ai/*"],
      "js": [
        "shared/i18n.js",
        "content_scripts/utils.js",
        "content_scripts/mcp_parser.js",
        "content_scripts/prompt_builder.js",
        "content_scripts/tool_catalog.js",
        "content_scripts/ui_widget.js",
        "content_scripts/adapters/base_adapter.js",
        "content_scripts/adapters/qwen.js",
        "content_scripts/core_bridge.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.kimi.ai/*",
        "https://kimi.ai/*",
        "https://www.kimi.com/*",
        "https://kimi.com/*"
      ],
      "js": [
        "shared/i18n.js",
        "content_scripts/utils.js",
        "content_scripts/mcp_parser.js",
        "content_scripts/prompt_builder.js",
        "content_scripts/tool_catalog.js",
        "content_scripts/ui_widget.js",
        "content_scripts/adapters/base_adapter.js",
        "content_scripts/adapters/kimi.js",
        "content_scripts/core_bridge.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
